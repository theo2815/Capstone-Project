{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-Command",
              "$p = if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { (Get-Location).Path }; Get-Content -Raw -LiteralPath (Join-Path $p '.claude\\preflight-reminder.txt')"
            ],
            "timeout": 10,
            "statusMessage": "Loading pre-flight checklist"
          }
        ]
      }
    ]
  }
}
