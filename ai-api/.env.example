# ============================================================
# QuickPitik API - Environment Configuration
# ============================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME=QuickPitik API
APP_VERSION=1.0.0
DEBUG=true
METRICS_ENABLED=true
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
READINESS_TIMEOUT_SECONDS=3

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quickpitik

# Redis
REDIS_URL=redis://localhost:6379/0

# Async image staging: leave bucket empty for local disk; set on API and worker together.
AWS_S3_BUCKET_NAME=
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual
BLOB_RETENTION_SECONDS=86400
CELERY_VISIBILITY_TIMEOUT=4200
JOB_LEASE_SECONDS=3900

# ML Models
MODEL_DIR=./models
# blur serves blur only (the default). all also turns face/bib on until that code is removed.
MODEL_PROFILE=blur
USE_GPU=false
GPU_DEVICE=0

# Blur Detection
# Set false only on a dedicated stream-only service; the shared service defaults to true.
BLUR_ASYNC_ENABLED=true
BLUR_THRESHOLD=100.0
BLUR_DETECT_DECODE_DIM=640
BLUR_DETECTION_MIN_CONFIDENCE=0.5
# Whole-frame blur rule; values come from scripts/fit_blur_whole_frame_rule.py
BLUR_SOFT_MAX_DETAIL=34.1
BLUR_MOTION_MIN_RATIO=2.63
BLUR_MOTION_MAX_DETAIL=52.4
# Used only when MODEL_PROFILE=blur; MODEL_PROFILE=all keeps its shared limits.
BLUR_MAX_REQUEST_BODY=134217728
BLUR_MAX_IMAGE_PIXELS=24000000
BLUR_MAX_ACTIVE_REQUESTS=2
BLUR_DECODE_CONCURRENCY=2
# Stage-2 photos scored at once per stream (1 = one after another; 2 uses both inference
# slots: set BLUR_MAX_ACTIVE_REQUESTS=1 beside it)
BLUR_STAGE2_CONCURRENCY=1
# ONNX Runtime worker threads spin between tasks (true); set false inside a small CPU quota
ONNX_ALLOW_SPINNING=true
BLUR_REQUEST_TIMEOUT_SECONDS=60
BLUR_INFERENCE_TIMEOUT_SECONDS=30
BLUR_STREAM_TIMEOUT_SECONDS=120

# Auth
API_KEY_HEADER=X-API-Key
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256

# Rate Limiting
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_BURST=10

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Webhooks
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3
# Fernet key encrypting webhook secrets at rest. Empty = secrets stored as
# PLAINTEXT (the app only logs a warning), which is why this is spelled out
# here rather than left to the default. Required in staging + production.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set the SAME value on the API and on every Celery worker — the API encrypts
# and the blur/face/bib workers decrypt, so a mismatch breaks every signature.
# Rotating it needs a full restart and does not re-encrypt existing rows.
WEBHOOK_SECRET_KEY=

# File Upload
# 25 MB — matches the Spring backend's multipart ceiling; it forwards ORIGINAL
# photo bytes for indexing, so anything it accepts must be accepted here.
MAX_FILE_SIZE=26214400
# Longest-edge upload bound. Fail-closed guard against absurd input, not a
# quality gate — sized to pass any real camera (102 MP = 11648x8736).
MAX_IMAGE_DIMENSION=12000
# Keep at the src/config.py default. This was 100 with nothing justifying it,
# while every doc, the backend's batch.max-size, and INFERENCE_SUB_BATCH_SIZE
# (whose "1 ONNX call per task" invariant it broke) all assume 50.
MAX_BATCH_SIZE=50
# Shared all-model request ceiling (2 GB), counted from actual received bytes.
# Sized for the backend's 50-photo mega drain; keep equal to nginx.conf.
MAX_REQUEST_BODY=2147483648
