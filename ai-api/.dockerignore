__pycache__
*.pyc
.venv
venv
.env
.git
.gitignore

# The audited blur pair is supplied to the build context from the controlled
# local artifact store. Other weights remain volume-mounted for the full image.
models/
!models/manifest.json
!models/blur_classifier/
models/blur_classifier/*
!models/blur_classifier/blur_classifier.onnx
!models/blur_classifier/class_names.json

# Training data and training outputs. Training-Images/ alone is ~16 GB; leaving
# these in meant every `docker build` shipped ~16 GB to the daemon before the
# first instruction ran, which is why a production build was never completed.
Training-Images/
runs/
benchmarks/

# Local C++ build artifacts — the extension is optional and every call site has
# a pure-Python fallback, so the image never needs a host-compiled .pyd.
build/
*.pyd
*.egg-info

# Training checkpoints left at the repo root (yolov8n-cls.pt). The image loads
# .onnx exports only — BibDetector refuses non-.onnx paths outright.
*.pt

tests/
*.md
.mypy_cache
.pytest_cache
.ruff_cache
htmlcov
