# Claude Code local permission state (per-developer)
.claude/settings.local.json

# ML Models (downloaded at build/start time)
# Ignore the directory's CONTENTS, not the directory itself: git cannot
# re-include a file whose parent directory is excluded, so `ai-api/models/` +
# `!ai-api/models/manifest.json` silently left the manifest untracked.
# Anchored to the repo root: an unanchored `models/` matches at ANY depth, so it
# also swallowed ai-api/models/ and defeated the negation below.
/models/
ai-api/models/*
!ai-api/models/manifest.json
*.pt
*.onnx

# Training data & runs (large files — hosted on GitLab via LFS)
ai-api/Training-Images/
ai-api/runs/
.gitattributes

# C++ build artifacts
ai-api/src/cpp/build/
ai-api/build/
ai-api/CMakeLists.txt
*.o
*.obj

# Claude Code temp files
tmpclaude-*
ai-api/tmpclaude-*

# Misc generated files
nul
ai-api/nul
Prompt.txt

# OS files
.DS_Store
Thumbs.db

