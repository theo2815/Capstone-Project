# Backend API URL (Spring Boot)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WebSocket URL (for real-time upload progress + live photo grid)
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Google OAuth Web client ID (public identifier). Unset hides the
# "Continue with Google" button on /login + /register. Must match the
# backend's GOOGLE_CLIENT_ID — same value, both sides.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public origin of this site (metadataBase for OG/canonical URLs). Set to the
# Vercel production domain; defaults to https://quickpitik.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
