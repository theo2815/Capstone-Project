# Production env for the website on Vercel.
#
# These are NOT read from this file — enter each one in
#   Vercel → Project → Settings → Environment Variables
# and tick both "Production" and "Preview". Every NEXT_PUBLIC_* value is
# inlined at build time, so a change needs a redeploy to take effect.
# Nothing here is a secret; all of it ships in the client bundle.

# Spring Boot backend (Railway). Keep the /api/v1 suffix.
# The build FAILS if this is unset (next.config.ts) — on purpose.
NEXT_PUBLIC_API_URL=https://<your-backend>.up.railway.app/api/v1

# Same host as the API, wss:// scheme, /ws suffix (no /api/v1).
NEXT_PUBLIC_WS_URL=wss://<your-backend>.up.railway.app/ws

# Google OAuth Web client ID — same value as the backend's GOOGLE_CLIENT_ID.
# Leave empty to hide the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Public origin of this deployment: metadataBase for OG / canonical URLs.
# Use the custom domain if you have one, else the Vercel production URL.
NEXT_PUBLIC_SITE_URL=https://<your-site>.vercel.app

# No TZ variable: Vercel reserves it and runs functions in UTC. Event state
# (upcoming / live / past) is pinned to Asia/Manila in code instead
# (lib/event-catalog.ts), so it needs nothing here.

# ── Backend side (Railway, not Vercel) — must match the values above ──
# CORS_ALLOWED_ORIGINS=https://<your-site>.vercel.app
#   (comma-separate to also allow preview deployments)
